# Servidor HTTP
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Obrigatório se HTTP_HOST for não-loopback (ex.: 0.0.0.0 fora de container loopback)
API_TOKEN=
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=whatshelper-brain

# MinIO (S3 compatível local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=whatshelper-blobs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# LLM ("fake" para rodar 100% offline; "anthropic" exige chave e modelos por estágio)
# Consulte a documentação oficial da Anthropic para os IDs de modelo atuais antes de configurar.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
MODEL_ANALYSIS=<modelo-anthropic-analise>
MODEL_RESPONSE=<modelo-anthropic-resposta>
MODEL_NUDGE=<modelo-anthropic-nudge>

# Pipeline
DEBOUNCE_MS=1500
RECENT_MESSAGES_LIMIT=20
PACKS_DIR=packs
TENANTS_DIR=tenants

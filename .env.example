# Servidor HTTP
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Obrigatório se HTTP_HOST for não-loopback (ex.: 0.0.0.0 fora de container loopback)
API_TOKEN=
# Token compartilhado entre cmd/brain e cmd/connectors (faz fallback para API_TOKEN se vazio)
CONNECTOR_TOKEN=
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text
# Chave AES-256-GCM (32 bytes em hex, base64 ou texto). Obrigatória em staging/production.
PII_ENCRYPTION_KEY=

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=whatshelper-brain

# MinIO (S3 compatível local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=whatshelper-blobs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# LLM ("fake" para rodar 100% offline; "anthropic", "gemini" ou "deepseek" exigem chave e modelos por estágio)
# Consulte a documentação oficial de cada provedor para os IDs de modelo atuais antes de configurar.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_ANALYSIS=<modelo-analise>
MODEL_RESPONSE=<modelo-resposta>
MODEL_NUDGE=<modelo-nudge>
MODEL_LEARNING=<modelo-aprendizado-opcional>

# Transcrição de áudio opcional (CH-06) — se TRANSCRIPTION_URL ficar vazio, áudio sem texto escalona com aviso neutro
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Pipeline
DEBOUNCE_MS=1500
RECENT_MESSAGES_LIMIT=20
PACKS_DIR=packs
TENANTS_DIR=tenants

# Connector WhatsApp local (CH-04)
WHATSAPP_ENABLED=true
WHATSAPP_DB_PATH=/data/whatsapp.db
WHATSAPP_TENANT_ID=demo
WHATSAPP_ACCOUNT=main
ADMIN_PHONE_E164=
WHATSAPP_ALLOW_GROUPS=false
WHATSAPP_PAIR_PHONE=

# Servidor HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# DynamoDB Local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=whatshelper-brain

# MinIO (S3 compatível local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=whatshelper-blobs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# LLM (Anthropic)
ANTHROPIC_API_KEY=
MODEL_ANALYSIS=claude-3-7-sonnet-20250219
MODEL_RESPONSE=claude-3-7-sonnet-20250219
MODEL_NUDGE=claude-3-5-haiku-20241022
